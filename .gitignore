# =============================================================================
# 基于YOLOv8的垃圾目标检测系统 - Git忽略规则
# 项目: YOLOv8-GarbageDetection
# 更新日期: 2026-01-13
# =============================================================================

# =============================================================================
# Python 运行时文件
# =============================================================================
# 字节码缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 解释器
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# =============================================================================
# 深度学习 / PyTorch / YOLO
# =============================================================================
# 模型权重文件（体积大，使用云盘存储）
*.pt
*.pth
*.onnx
*.engine
*.trt
*.pb
*.h5
*.keras
*.caffemodel
*.weights

# 训练输出目录
runs/
training/runs/
wandb/
mlruns/
lightning_logs/

# TensorBoard日志
events.out.tfevents.*

# 模型导出
exports/

# =============================================================================
# 数据集（使用阿里云盘存储，不纳入Git）
# =============================================================================
# 图片数据
data/datasets/images/
data/datasets/labels/
datasets/images/
datasets/labels/
*.jpg
*.jpeg
*.png
*.bmp
*.gif
*.tiff
*.webp

# 但保留示例图片目录
!TestFiles/

# 标签文件（批量）
*.txt
# 但保留配置文件
!requirements.txt
!*.yaml
!*.yml

# 压缩包
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z

# 视频文件
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.MP4

